# Environment Configuration for Persian & Arabic Manuscript HTR/OCR Platform

# Application Environment (development | production | test)
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://htr_user:htr_secret_password@localhost:5432/manuscript_htr_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-jwt-signing-key-for-persian-arabic-htr-platform-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# External Python AI Service (FastAPI)
AI_SERVICE_URL="http://ai-service:8000"
AI_SERVICE_TIMEOUT_MS=30000

# Storage Configuration
STORAGE_ROOT="./storage/manuscripts"
MAX_UPLOAD_SIZE=20971520 # 20MB in bytes
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/tiff,image/webp"

# CORS and Security
CORS_ORIGINS="*"
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Initial System Admin Seed (Optional - used during database seed)
DEFAULT_ADMIN_EMAIL="admin@manuscript-htr.edu"
DEFAULT_ADMIN_PASSWORD="AdminSecurePassword123!"
DEFAULT_ADMIN_NAME="Chief Manuscript Archivist"
